{
  "contract_id": "PMOS-EVAL-READINESS",
  "contract_version": 1,
  "functional_requirements": {
    "FR-001": {
      "statement": "The generated readiness report returns an ok status."
    },
    "FR-002": {
      "statement": "The readiness report identifies the evaluated component."
    },
    "FR-003": {
      "statement": "The readiness report lists the completed contract and sandbox checks."
    }
  },
  "acceptance_criteria": {
    "AC-001": {
      "requirement_refs": [
        "FR-001"
      ],
      "given": [
        {
          "path": "service.running",
          "operator": "eq",
          "value": true
        }
      ],
      "when": {
        "action": "health",
        "arguments": {}
      },
      "then": [
        {
          "path": "result.status",
          "operator": "eq",
          "value": "ok"
        }
      ]
    },
    "AC-002": {
      "requirement_refs": [
        "FR-002"
      ],
      "given": [
        {
          "path": "service.running",
          "operator": "eq",
          "value": true
        }
      ],
      "when": {
        "action": "health",
        "arguments": {}
      },
      "then": [
        {
          "path": "result.component",
          "operator": "eq",
          "value": "readiness-api"
        }
      ]
    },
    "AC-003": {
      "requirement_refs": [
        "FR-003"
      ],
      "given": [
        {
          "path": "service.running",
          "operator": "eq",
          "value": true
        }
      ],
      "when": {
        "action": "health",
        "arguments": {}
      },
      "then": [
        {
          "path": "result.checks",
          "operator": "contains",
          "value": "contract"
        },
        {
          "path": "result.checks",
          "operator": "contains",
          "value": "sandbox"
        }
      ]
    }
  },
  "contract_status": "APPROVED",
