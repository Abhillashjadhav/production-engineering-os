{
  "contract_id": "PMOS-E1",
  "contract_version": 1,
  "functional_requirements": {
    "FR-001": {
      "statement": "The generated product reports that its health is ok."
    }
  },
  "acceptance_criteria": {
    "AC-001": {
      "requirement_refs": [
        "FR-001"
      ],
      "given": [
        {
          "path": "service.running",
          "operator": "eq",
          "value": true
        }
      ],
      "when": {
        "action": "health",
        "arguments": {}
      },
      "then": [
        {
          "path": "result.status",
          "operator": "eq",
          "value": "ok"
        }
      ]
    }
  }
}
