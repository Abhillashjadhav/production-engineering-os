{
  "$comment": "Before schema evaluation, issue #76 admission MUST reject duplicate object member names, non-JSON numeric constants, and numeric tokens that overflow to non-finite IEEE-754 values, then canonicalize the parsed instance with RFC 8785 for digesting. Member bytes are addressed by content digest and stable member ID; caller-controlled extraction paths are intentionally absent, so duplicate and file/directory-prefix path identities cannot enter the manifest. JSON Schema evaluates parsed instances and cannot observe raw member tokens.",
  "$defs": {
    "date_time": {
      "description": "UTC RFC 3339 instant. Calendar validity is rechecked by the semantic validator.",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z(?![\\s\\S])",
      "type": "string"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
      "type": "string"
    },
    "https_uri": {
      "description": "Absolute HTTPS schema identifier without credentials, query, fragment, or non-standard port; percent escapes must be valid.",
      "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:/(?:[A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2})*)*(?![\\s\\S])",
      "type": "string"
    },
    "member_id": {
      "description": "Non-bundle member ID. The reserved canonical bundle member ID cannot reappear in this registry.",
      "pattern": "^(?!MEMBER-CANONICAL-BUNDLE(?![\\s\\S]))MEMBER-[A-Z0-9]+(?:-[A-Z0-9]+)*(?![\\s\\S])",
      "type": "string"
    },
    "non_empty_string": {
      "minLength": 1,
      "type": "string"
    },
    "semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])",
      "type": "string"
    },
    "source_id": {
      "pattern": "^PMOS-[A-Z0-9]+(?:-[A-Z0-9]+)*(?![\\s\\S])",
      "type": "string"
    }
  },
  "$id": "https://github.com/Abhillashjadhav/production-engineering-os/schemas/pmos_contract_manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Content-addressed manifest for a canonical PMOS contract bundle. The canonical bundle is a dedicated member, eliminating independently variable duplicate IDs, versions, digests, and source references.",
  "properties": {
    "approval_digest": {
      "$ref": "#/$defs/digest"
    },
    "bundle": {
      "additionalProperties": false,
      "properties": {
        "bundle_id": {
          "pattern": "^BUNDLE-[A-Z0-9]+(?:-[A-Z0-9]+)*(?![\\s\\S])",
          "type": "string"
        },
        "bundle_version": {
          "$ref": "#/$defs/semver"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        },
        "media_type": {
          "const": "application/json"
        },
        "member_id": {
          "const": "MEMBER-CANONICAL-BUNDLE"
        },
        "schema_id": {
          "const": "https://github.com/Abhillashjadhav/production-engineering-os/schemas/pmos_contract_bundle.schema.json"
        },
        "schema_version": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        }
      },
      "required": [
        "bundle_id",
        "bundle_version",
        "content_digest",
        "media_type",
        "member_id",
        "schema_id",
        "schema_version"
      ],
      "type": "object"
    },
    "canonical_json_profile": {
      "const": "RFC8785",
      "description": "Declares the canonicalization profile used after duplicate-aware parsing and before content digesting."
    },
    "created_at": {
      "$ref": "#/$defs/date_time"
    },
    "manifest_id": {
      "pattern": "^MANIFEST-[A-Z0-9]+(?:-[A-Z0-9]+)*(?![\\s\\S])",
      "type": "string"
    },
    "manifest_version": {
      "$ref": "#/$defs/semver"
    },
    "members": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "content_digest": {
            "$ref": "#/$defs/digest"
          },
          "kind": {
            "enum": [
              "ATTACHMENT",
              "EXTENSION_SCHEMA"
            ],
            "type": "string"
          },
          "media_type": {
            "$ref": "#/$defs/non_empty_string"
          },
          "schema_id": {
            "$ref": "#/$defs/https_uri"
          },
          "schema_version": {
            "$ref": "#/$defs/semver"
          }
        },
        "required": [
          "content_digest",
          "kind",
          "media_type",
          "schema_id",
          "schema_version"
        ],
        "type": "object"
      },
      "description": "Registry of content-addressed non-bundle members keyed by stable member ID. Caller-controlled storage or extraction paths are forbidden; issue #76 materialization must derive any local layout from the admitted ID/digest inventory. It may be empty when the canonical bundle is the only member.",
      "propertyNames": {
        "$ref": "#/$defs/member_id"
      },
      "type": "object"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "compiler_provenance": {
          "additionalProperties": false,
          "description": "Reserved for issue #76. Omit for a natively authored canonical bundle.",
          "properties": {
            "compiler_id": {
              "$ref": "#/$defs/non_empty_string"
            },
            "compiler_version": {
              "$ref": "#/$defs/semver"
            },
            "input_digest": {
              "$ref": "#/$defs/digest"
            }
          },
          "required": [
            "compiler_id",
            "compiler_version",
            "input_digest"
          ],
          "type": "object"
        },
        "published_at": {
          "$ref": "#/$defs/date_time"
        },
        "source_digest": {
          "$ref": "#/$defs/digest"
        },
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "source_system": {
          "const": "PM_AGENT_OS",
          "description": "PM Agent OS owns the source product truth."
        },
        "source_version": {
          "$ref": "#/$defs/semver"
        }
      },
      "required": [
        "published_at",
        "source_digest",
        "source_id",
        "source_system",
        "source_version"
      ],
      "type": "object"
    },
    "schema_id": {
      "const": "https://github.com/Abhillashjadhav/production-engineering-os/schemas/pmos_contract_manifest.schema.json"
    },
    "schema_version": {
      "enum": [
        "1.0.0"
      ],
      "type": "string"
    }
  },
  "required": [
    "approval_digest",
    "bundle",
    "canonical_json_profile",
    "created_at",
    "manifest_id",
    "manifest_version",
    "members",
    "provenance",
    "schema_id",
    "schema_version"
  ],
  "title": "Canonical PMOS Contract Manifest",
  "type": "object"
}
