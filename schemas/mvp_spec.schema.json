{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Abhillashjadhav/production-engineering-os/schemas/mvp_spec.schema.json",
  "title": "PM OS MVP Specification",
  "description": "Input contract between the PM OS (pm-agent-os) and the PM Production Engineering OS. The pipeline validates structure against this schema (pmpe.ingestion implements the documented subset: type, required, properties, items, enum, minItems, minLength), then applies semantic validation (pmpe.validation).",
  "type": "object",
  "required": [
    "spec_version",
    "product_name",
    "problem_statement",
    "target_user",
    "user_outcome",
    "business_outcome",
    "scope",
    "non_goals",
    "user_stories",
    "acceptance_criteria",
    "functional_requirements",
    "north_star_metric",
    "priority",
    "target_platform",
    "deployment_target"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "enum": ["1.0"],
      "description": "Contract version. The pipeline rejects versions it does not implement."
    },
    "product_name": { "type": "string", "minLength": 1 },
    "problem_statement": { "type": "string", "minLength": 10 },
    "target_user": { "type": "string", "minLength": 1 },
    "user_outcome": {
      "type": "string",
      "minLength": 1,
      "description": "What the user can do/achieve after the MVP ships."
    },
    "business_outcome": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string" },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "What V1 builds. Checked for contradictions against non_goals."
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "user_stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["as_a", "i_want", "so_that"],
        "properties": {
          "id": { "type": "string", "description": "US-xxx; assigned during normalization when absent." },
          "as_a": { "type": "string", "minLength": 1 },
          "i_want": { "type": "string", "minLength": 1 },
          "so_that": { "type": "string", "minLength": 1 }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement", "criterion"],
        "properties": {
          "id": { "type": "string", "description": "AC-xxx; assigned during normalization when absent." },
          "requirement": { "type": "string", "description": "The FR-xxx this criterion verifies." },
          "criterion": {
            "type": "string",
            "minLength": 1,
            "description": "Testable statement. Semantic validation flags vague criteria (no observable outcome, no measurable condition)."
          }
        }
      }
    },
    "functional_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "capability"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "description": "FR-xxx, stable, referenced by acceptance_criteria and traceability." },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "capability": {
            "type": "string",
            "enum": [
              "auth.bearer_token",
              "entity.create",
              "entity.read",
              "entity.update",
              "entity.delete",
              "entity.list",
              "health.check"
            ],
            "description": "Machine-readable capability. The stack adapter declares which capabilities it supports; unsupported ones raise an escalation instead of silent improvisation."
          },
          "entity": { "type": "string", "description": "Entity name for entity.* capabilities; must exist in entities[]." }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "fields"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "enum": ["string", "text", "int", "bool", "timestamp"] },
                "required": { "type": "boolean" },
                "default": { "type": "string" }
              }
            }
          }
        }
      },
      "description": "Data model. Required (semantically) when any entity.* capability is used. id/created_at/updated_at are generated automatically and must not be declared."
    },
    "non_functional_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "requirement"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string", "enum": ["performance", "security", "reliability", "usability", "maintainability", "compliance"] },
          "requirement": { "type": "string", "minLength": 1 }
        }
      }
    },
    "success_metrics": { "type": "array", "items": { "type": "string" } },
    "north_star_metric": {
      "type": "string",
      "minLength": 1,
      "description": "Must express an OUTCOME. Semantic validation flags activity-only NSMs (signups, clicks, sessions, pageviews...)."
    },
    "leading_metrics": { "type": "array", "items": { "type": "string" } },
    "guardrails": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "External dependencies the product needs. Referenced-but-undeclared dependencies are flagged."
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "level": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
    "target_platform": {
      "type": "string",
      "enum": ["api"],
      "description": "V1 supports the API reference application type only. New platforms arrive as stack adapters."
    },
    "preferred_stack": {
      "type": "string",
      "enum": ["python-stdlib"],
      "description": "V1 supports the python-stdlib reference stack only."
    },
    "deployment_target": {
      "type": "string",
      "enum": ["local", "staging", "production"],
      "description": "local deploys and verifies on this machine. staging/production raise a high-risk escalation in V1 (no cloud adapters yet)."
    }
  }
}
