{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Abhillashjadhav/production-engineering-os/schemas/product_decision_contract.schema.json",
  "title": "ProductDecisionContract",
  "description": "The boundary object between PM Agent OS (product intent, PD-01) and Production Engineering OS (engineering execution, PD-02). Immutable within an engineering run (PD-03): the canonical digest is computed over the whole document and any post-lock mutation fails closed. Structure is validated by pmpe.ingestion.SchemaValidator (documented subset); semantic runnability rules live in pmpe.contracts.model.",
  "type": "object",
  "required": [
    "contract_version",
    "contract_id",
    "contract_status",
    "approved_at",
    "approved_by",
    "source_digest",
    "product_name",
    "problem",
    "target_user",
    "desired_outcome",
    "scope",
    "out_of_scope",
    "functional_requirements",
    "acceptance_criteria",
    "binary_release_gates",
    "scored_eval_rubric",
    "golden_cases",
    "north_star_metric",
    "leading_metrics",
    "guardrails",
    "non_functional_requirements",
    "known_risks",
    "approved_product_decisions",
    "unresolved_questions",
    "required_approvals"
  ],
  "properties": {
    "contract_version": { "type": "integer" },
    "contract_id": { "type": "string", "minLength": 1 },
    "contract_status": {
      "type": "string",
      "enum": ["DRAFT", "APPROVED", "SUPERSEDED", "REJECTED"]
    },
    "approved_at": { "type": "string" },
    "approved_by": { "type": "string" },
    "source_digest": {
      "type": "string",
      "description": "Digest of the upstream PM Agent OS source material this contract was derived from."
    },
    "product_name": { "type": "string", "minLength": 1 },
    "problem": { "type": "string", "minLength": 10 },
    "target_user": { "type": "string", "minLength": 1 },
    "desired_outcome": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "out_of_scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "functional_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "capability": { "type": "string" },
          "entity": { "type": "string" }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "requirement", "criterion"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "requirement": { "type": "string", "minLength": 1 },
          "criterion": { "type": "string", "minLength": 1 }
        }
      }
    },
    "binary_release_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scored_eval_rubric": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "criterion"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "criterion": { "type": "string", "minLength": 1 },
          "scale": { "type": "string" }
        }
      }
    },
    "golden_cases": { "type": "array", "items": { "type": "string" } },
    "north_star_metric": { "type": "string", "minLength": 1 },
    "leading_metrics": { "type": "array", "items": { "type": "string" } },
    "guardrails": { "type": "array", "items": { "type": "string" } },
    "non_functional_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "requirement"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "requirement": { "type": "string", "minLength": 1 }
        }
      }
    },
    "known_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "level": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "approved_product_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "decision"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "product_critical"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "product_critical": { "type": "boolean" },
          "resolution": { "type": "string" }
        }
      }
    },
    "required_approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "for"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "for": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
