{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/personal-workflow-request.schema.json",
  "title": "Personal Execution OS Governed Workflow Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "problem",
    "hypothesis",
    "proposed_answer",
    "target_outcome",
    "deadline",
    "success",
    "trade_off",
    "scope",
    "non_goals",
    "workflow_ids",
    "approved_by",
    "evidence_sources",
    "workflow_inputs"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"$ref": "#/$defs/id"},
    "problem": {"$ref": "#/$defs/text"},
    "hypothesis": {"$ref": "#/$defs/text"},
    "proposed_answer": {"$ref": "#/$defs/text"},
    "target_outcome": {"$ref": "#/$defs/text"},
    "deadline": {"type": "string", "minLength": 1, "maxLength": 128},
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["north_star", "leading", "guardrails"],
      "properties": {
        "north_star": {"$ref": "#/$defs/text"},
        "leading": {"$ref": "#/$defs/textList"},
        "guardrails": {"$ref": "#/$defs/textList"}
      }
    },
    "trade_off": {"$ref": "#/$defs/text"},
    "scope": {"$ref": "#/$defs/textList"},
    "non_goals": {"$ref": "#/$defs/textList"},
    "workflow_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/workflowId"}
    },
    "approved_by": {"$ref": "#/$defs/id"},
    "evidence_sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceSource"}
    },
    "workflow_inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goal-to-verified-release": {"$ref": "#/$defs/goalInput"},
        "ai-eval-release-gate": {"$ref": "#/$defs/evalInput"},
        "weekly-pm-command-centre": {"$ref": "#/$defs/commandInput"},
        "meeting-to-decision": {"$ref": "#/$defs/meetingInput"},
        "evidence-to-roadmap-to-release": {"$ref": "#/$defs/roadmapInput"},
        "issue-to-draft-pr": {"$ref": "#/$defs/issueInput"},
        "prd-architecture-task-compiler": {"$ref": "#/$defs/genericOutcomeInput"},
        "release-readiness-room": {"$ref": "#/$defs/genericOutcomeInput"},
        "experiment-to-decision": {"$ref": "#/$defs/genericOutcomeInput"},
        "incident-to-prevention": {"$ref": "#/$defs/genericOutcomeInput"},
        "migration-impact-planner": {"$ref": "#/$defs/genericOutcomeInput"},
        "docs-runbook-drift-maintainer": {"$ref": "#/$defs/genericOutcomeInput"},
        "customer-research-synthesis": {"$ref": "#/$defs/genericOutcomeInput"},
        "competitive-market-watch": {"$ref": "#/$defs/genericOutcomeInput"},
        "verified-executive-update": {"$ref": "#/$defs/genericOutcomeInput"},
        "research-to-prototype": {"$ref": "#/$defs/genericOutcomeInput"},
        "idea-to-deploy-starter": {"$ref": "#/$defs/genericOutcomeInput"},
        "data-to-small-tool": {"$ref": "#/$defs/genericOutcomeInput"},
        "repo-doctor": {"$ref": "#/$defs/genericOutcomeInput"},
        "learning-to-build-coach": {"$ref": "#/$defs/genericOutcomeInput"},
        "career-proof-pack": {"$ref": "#/$defs/genericOutcomeInput"}
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "text": {"type": "string", "minLength": 1, "maxLength": 4096},
    "shortText": {"type": "string", "minLength": 1, "maxLength": 1024},
    "textList": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/shortText"}
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "workflowId": {
      "enum": [
        "goal-to-verified-release",
        "ai-eval-release-gate",
        "weekly-pm-command-centre",
        "meeting-to-decision",
        "evidence-to-roadmap-to-release",
        "issue-to-draft-pr",
        "prd-architecture-task-compiler",
        "release-readiness-room",
        "experiment-to-decision",
        "incident-to-prevention",
        "migration-impact-planner",
        "docs-runbook-drift-maintainer",
        "customer-research-synthesis",
        "competitive-market-watch",
        "verified-executive-update",
        "research-to-prototype",
        "idea-to-deploy-starter",
        "data-to-small-tool",
        "repo-doctor",
        "learning-to-build-coach",
        "career-proof-pack"
      ]
    },
    "evidenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "title", "uri", "observed_at", "content", "content_digest"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "kind": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/shortText"},
        "uri": {"type": "string", "minLength": 1, "maxLength": 2048},
        "observed_at": {"type": "string", "minLength": 1, "maxLength": 128},
        "content": {},
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "baseInput": {
      "type": "object",
      "required": ["evidence_source_ids"],
      "properties": {"evidence_source_ids": {"$ref": "#/$defs/idList"}}
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "description", "status", "evidence_source_ids"],
      "properties": {
        "check_id": {"$ref": "#/$defs/id"},
        "description": {"$ref": "#/$defs/shortText"},
        "status": {"enum": ["PASS", "FAIL"]},
        "evidence_source_ids": {"$ref": "#/$defs/idList"}
      }
    },
    "goalInput": {
      "allOf": [
        {"$ref": "#/$defs/baseInput"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_source_ids", "goal_id", "release_candidate_digest", "acceptance_checks", "release_target"],
          "properties": {
            "evidence_source_ids": {"$ref": "#/$defs/idList"},
            "goal_id": {"$ref": "#/$defs/id"},
            "release_candidate_digest": {"$ref": "#/$defs/digest"},
            "acceptance_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
            "release_target": {"$ref": "#/$defs/shortText"}
          }
        }
      ]
    },
    "evalInput": {
      "allOf": [
        {"$ref": "#/$defs/baseInput"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_source_ids", "candidate_id", "golden_cases", "thresholds", "release_target"],
          "properties": {
            "evidence_source_ids": {"$ref": "#/$defs/idList"},
            "candidate_id": {"$ref": "#/$defs/id"},
            "release_target": {"$ref": "#/$defs/shortText"},
            "golden_cases": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["case_id", "expected", "actual", "safety_pass", "latency_ms", "cost_usd", "evidence_source_ids"],
                "properties": {
                  "case_id": {"$ref": "#/$defs/id"},
                  "expected": {"$ref": "#/$defs/text"},
                  "actual": {"$ref": "#/$defs/text"},
                  "safety_pass": {"type": "boolean"},
                  "latency_ms": {"type": "integer", "minimum": 0},
                  "cost_usd": {"type": "number", "minimum": 0},
                  "evidence_source_ids": {"$ref": "#/$defs/idList"}
                }
              }
            },
            "thresholds": {
              "type": "object",
              "additionalProperties": false,
              "required": ["min_pass_rate", "max_p95_latency_ms", "max_average_cost_usd", "max_safety_failures"],
              "properties": {
                "min_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
                "max_p95_latency_ms": {"type": "integer", "minimum": 0},
                "max_average_cost_usd": {"type": "number", "minimum": 0},
                "max_safety_failures": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      ]
    },
    "commandInput": {
      "allOf": [
        {"$ref": "#/$defs/baseInput"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_source_ids", "timezone", "calendar_events", "commitments", "messages"],
          "properties": {
            "evidence_source_ids": {"$ref": "#/$defs/idList"},
            "timezone": {"$ref": "#/$defs/shortText"},
            "calendar_events": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["event_id", "title", "start", "end"],
                "properties": {
                  "event_id": {"$ref": "#/$defs/id"},
                  "title": {"$ref": "#/$defs/shortText"},
                  "start": {"$ref": "#/$defs/shortText"},
                  "end": {"$ref": "#/$defs/shortText"}
                }
              }
            },
            "commitments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["commitment_id", "text", "due", "status", "impact"],
                "properties": {
                  "commitment_id": {"$ref": "#/$defs/id"},
                  "text": {"$ref": "#/$defs/shortText"},
                  "due": {"$ref": "#/$defs/shortText"},
                  "status": {"enum": ["OPEN", "DONE"]},
                  "impact": {"enum": ["HIGH", "MEDIUM", "LOW"]}
                }
              }
            },
            "messages": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["message_id", "subject", "action_requested", "importance"],
                "properties": {
                  "message_id": {"$ref": "#/$defs/id"},
                  "subject": {"$ref": "#/$defs/shortText"},
                  "action_requested": {"$ref": "#/$defs/shortText"},
                  "importance": {"type": "integer", "minimum": 1, "maximum": 5}
                }
              }
            }
          }
        }
      ]
    },
    "meetingInput": {
      "allOf": [
        {"$ref": "#/$defs/baseInput"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_source_ids", "meeting_id", "title", "scheduled_at", "agenda", "prior_decisions", "notes", "action_items", "follow_up_target"],
          "properties": {
            "evidence_source_ids": {"$ref": "#/$defs/idList"},
            "meeting_id": {"$ref": "#/$defs/id"},
            "title": {"$ref": "#/$defs/shortText"},
            "scheduled_at": {"$ref": "#/$defs/shortText"},
            "agenda": {"$ref": "#/$defs/textList"},
            "prior_decisions": {"$ref": "#/$defs/textList"},
            "notes": {"$ref": "#/$defs/textList"},
            "action_items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["action_id", "text", "owner", "due"],
                "properties": {
                  "action_id": {"$ref": "#/$defs/id"},
                  "text": {"$ref": "#/$defs/shortText"},
                  "owner": {"$ref": "#/$defs/id"},
                  "due": {"$ref": "#/$defs/shortText"}
                }
              }
            },
            "follow_up_target": {"$ref": "#/$defs/shortText"}
          }
        }
      ]
    },
    "roadmapInput": {
      "allOf": [
        {"$ref": "#/$defs/baseInput"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_source_ids", "claims", "options", "approved_option_id", "requirements", "release_checks", "roadmap_target"],
          "properties": {
            "evidence_source_ids": {"$ref": "#/$defs/idList"},
            "claims": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["claim_id", "text", "source_ids"],
                "properties": {
                  "claim_id": {"$ref": "#/$defs/id"},
                  "text": {"$ref": "#/$defs/text"},
                  "source_ids": {"$ref": "#/$defs/idList"}
                }
              }
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["option_id", "title", "pros", "cons"],
                "properties": {
                  "option_id": {"$ref": "#/$defs/id"},
                  "title": {"$ref": "#/$defs/shortText"},
                  "pros": {"$ref": "#/$defs/textList"},
                  "cons": {"$ref": "#/$defs/textList"}
                }
              }
            },
            "approved_option_id": {"$ref": "#/$defs/id"},
            "requirements": {"$ref": "#/$defs/textList"},
            "release_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
            "roadmap_target": {"$ref": "#/$defs/shortText"}
          }
        }
      ]
    },
    "genericOutcomeInput": {
      "allOf": [
        {"$ref": "#/$defs/baseInput"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_source_ids", "subject_id", "objective", "records", "checks", "output_target", "approval_actions"],
          "properties": {
            "evidence_source_ids": {"$ref": "#/$defs/idList"},
            "subject_id": {"$ref": "#/$defs/id"},
            "objective": {"$ref": "#/$defs/text"},
            "output_target": {"$ref": "#/$defs/shortText"},
            "records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["record_id", "title", "content", "evidence_source_ids"],
                "properties": {
                  "record_id": {"$ref": "#/$defs/id"},
                  "title": {"$ref": "#/$defs/shortText"},
                  "content": {"type": "object", "minProperties": 1},
                  "evidence_source_ids": {"$ref": "#/$defs/idList"}
                }
              }
            },
            "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
            "approval_actions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["action_type", "target", "operation", "reason", "reversibility"],
                "properties": {
                  "action_type": {"$ref": "#/$defs/id"},
                  "target": {"$ref": "#/$defs/shortText"},
                  "operation": {"$ref": "#/$defs/id"},
                  "reason": {"$ref": "#/$defs/shortText"},
                  "reversibility": {"$ref": "#/$defs/shortText"}
                }
              }
            }
          }
        }
      ]
    },
    "issueInput": {
      "allOf": [
        {"$ref": "#/$defs/baseInput"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_source_ids", "repository", "issue_number", "issue_title", "issue_body", "impact_paths", "dependencies", "candidate_digest", "checks", "pr_title", "pr_body"],
          "properties": {
            "evidence_source_ids": {"$ref": "#/$defs/idList"},
            "repository": {"$ref": "#/$defs/shortText"},
            "issue_number": {"type": "integer", "minimum": 1},
            "issue_title": {"$ref": "#/$defs/shortText"},
            "issue_body": {"$ref": "#/$defs/text"},
            "impact_paths": {"$ref": "#/$defs/textList"},
            "dependencies": {"type": "array", "items": {"$ref": "#/$defs/shortText"}},
            "candidate_digest": {"$ref": "#/$defs/digest"},
            "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
            "pr_title": {"$ref": "#/$defs/shortText"},
            "pr_body": {"$ref": "#/$defs/text"}
          }
        }
      ]
    }
  }
}
