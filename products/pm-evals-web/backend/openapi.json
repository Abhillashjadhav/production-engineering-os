{
  "components": {
    "schemas": {
      "Body_compare_api_compare_post": {
        "properties": {
          "baseline": {
            "contentMediaType": "application/octet-stream",
            "title": "Baseline",
            "type": "string"
          },
          "candidate": {
            "contentMediaType": "application/octet-stream",
            "title": "Candidate",
            "type": "string"
          },
          "min_matched_traces": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Matched Traces"
          }
        },
        "required": [
          "baseline",
          "candidate"
        ],
        "title": "Body_compare_api_compare_post",
        "type": "object"
      },
      "Body_report_api_report_post": {
        "properties": {
          "baseline": {
            "contentMediaType": "application/octet-stream",
            "title": "Baseline",
            "type": "string"
          },
          "candidate": {
            "contentMediaType": "application/octet-stream",
            "title": "Candidate",
            "type": "string"
          },
          "format": {
            "default": "markdown",
            "enum": [
              "markdown",
              "json"
            ],
            "title": "Format",
            "type": "string"
          },
          "min_matched_traces": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Matched Traces"
          }
        },
        "required": [
          "baseline",
          "candidate"
        ],
        "title": "Body_report_api_report_post",
        "type": "object"
      },
      "CompareResponse": {
        "properties": {
          "comparison": {
            "$ref": "#/components/schemas/Comparison"
          }
        },
        "required": [
          "comparison"
        ],
        "title": "CompareResponse",
        "type": "object"
      },
      "Comparison": {
        "properties": {
          "baseline_digest": {
            "title": "Baseline Digest",
            "type": "string"
          },
          "baseline_only_traces": {
            "items": {
              "type": "string"
            },
            "title": "Baseline Only Traces",
            "type": "array"
          },
          "baseline_pass_rate": {
            "title": "Baseline Pass Rate",
            "type": "number"
          },
          "baseline_run_id": {
            "title": "Baseline Run Id",
            "type": "string"
          },
          "candidate_digest": {
            "title": "Candidate Digest",
            "type": "string"
          },
          "candidate_only_traces": {
            "items": {
              "type": "string"
            },
            "title": "Candidate Only Traces",
            "type": "array"
          },
          "candidate_pass_rate": {
            "title": "Candidate Pass Rate",
            "type": "number"
          },
          "candidate_run_id": {
            "title": "Candidate Run Id",
            "type": "string"
          },
          "criteria": {
            "items": {
              "$ref": "#/components/schemas/CriterionDelta"
            },
            "title": "Criteria",
            "type": "array"
          },
          "hard_gate_regressions": {
            "items": {
              "type": "string"
            },
            "title": "Hard Gate Regressions",
            "type": "array"
          },
          "matched_traces": {
            "title": "Matched Traces",
            "type": "integer"
          },
          "net_change": {
            "title": "Net Change",
            "type": "number"
          },
          "newly_failing_traces": {
            "items": {
              "type": "string"
            },
            "title": "Newly Failing Traces",
            "type": "array"
          },
          "newly_passing_traces": {
            "items": {
              "type": "string"
            },
            "title": "Newly Passing Traces",
            "type": "array"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/VerdictReason"
            },
            "title": "Reasons",
            "type": "array"
          },
          "suite": {
            "title": "Suite",
            "type": "string"
          },
          "verdict": {
            "title": "Verdict",
            "type": "string"
          }
        },
        "required": [
          "suite",
          "baseline_run_id",
          "candidate_run_id",
          "baseline_digest",
          "candidate_digest",
          "matched_traces",
          "baseline_only_traces",
          "candidate_only_traces",
          "baseline_pass_rate",
          "candidate_pass_rate",
          "net_change",
          "criteria",
          "newly_passing_traces",
          "newly_failing_traces",
          "hard_gate_regressions",
          "verdict",
          "reasons"
        ],
        "title": "Comparison",
        "type": "object"
      },
      "CriterionDelta": {
        "properties": {
          "baseline_pass_rate": {
            "title": "Baseline Pass Rate",
            "type": "number"
          },
          "candidate_pass_rate": {
            "title": "Candidate Pass Rate",
            "type": "number"
          },
          "covered_traces": {
            "title": "Covered Traces",
            "type": "integer"
          },
          "criterion_id": {
            "title": "Criterion Id",
            "type": "string"
          },
          "delta": {
            "title": "Delta",
            "type": "number"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "hard_gate": {
            "title": "Hard Gate",
            "type": "boolean"
          },
          "newly_failing": {
            "items": {
              "type": "string"
            },
            "title": "Newly Failing",
            "type": "array"
          },
          "newly_passing": {
            "items": {
              "type": "string"
            },
            "title": "Newly Passing",
            "type": "array"
          }
        },
        "required": [
          "criterion_id",
          "description",
          "hard_gate",
          "baseline_pass_rate",
          "candidate_pass_rate",
          "delta",
          "newly_passing",
          "newly_failing",
          "covered_traces"
        ],
        "title": "CriterionDelta",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "api_version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ParseIssue": {
        "description": "One named problem with an uploaded run file.",
        "properties": {
          "location": {
            "title": "Location",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "location",
          "message"
        ],
        "title": "ParseIssue",
        "type": "object"
      },
      "ValidationProblem": {
        "properties": {
          "issues": {
            "items": {
              "$ref": "#/components/schemas/ParseIssue"
            },
            "title": "Issues",
            "type": "array"
          },
          "source": {
            "enum": [
              "baseline",
              "candidate"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "source",
          "issues"
        ],
        "title": "ValidationProblem",
        "type": "object"
      },
      "VerdictReason": {
        "properties": {
          "criterion_id": {
            "default": "",
            "title": "Criterion Id",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "trace_ids": {
            "items": {
              "type": "string"
            },
            "title": "Trace Ids",
            "type": "array"
          }
        },
        "required": [
          "kind",
          "detail"
        ],
        "title": "VerdictReason",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Compare two eval runs and receive an evidence-backed release verdict. Uploads are processed in memory and never stored.",
    "title": "pm-evals Web API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/compare": {
      "post": {
        "operationId": "compare_api_compare_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_compare_api_compare_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompareResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "description": "An uploaded file exceeds the size limit."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ValidationProblem"
                  },
                  "title": "Response 422 Compare Api Compare Post",
                  "type": "array"
                }
              }
            },
            "description": "Malformed upload(s): named per-source parse issues."
          }
        },
        "summary": "Compare"
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/report": {
      "post": {
        "operationId": "report_api_report_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_report_api_report_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "The comparison report as a downloadable attachment (text/markdown or application/json, server-generated filename)."
          },
          "413": {
            "description": "An uploaded file exceeds the size limit."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ValidationProblem"
                  },
                  "title": "Response 422 Report Api Report Post",
                  "type": "array"
                }
              }
            },
            "description": "Malformed upload(s): named per-source parse issues."
          }
        },
        "summary": "Report"
      }
    }
  }
}
