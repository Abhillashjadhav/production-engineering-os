{
  "components": {
    "schemas": {
      "Body_compare_api_compare_post": {
        "properties": {
          "baseline": {
            "contentMediaType": "application/octet-stream",
            "title": "Baseline",
            "type": "string"
          },
          "candidate": {
            "contentMediaType": "application/octet-stream",
            "title": "Candidate",
            "type": "string"
          },
          "min_matched_traces": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Matched Traces"
          }
        },
        "required": [
          "baseline",
          "candidate"
        ],
        "title": "Body_compare_api_compare_post",
        "type": "object"
      },
      "Body_report_api_report_post": {
        "properties": {
          "baseline": {
            "contentMediaType": "application/octet-stream",
            "title": "Baseline",
            "type": "string"
          },
          "candidate": {
            "contentMediaType": "application/octet-stream",
            "title": "Candidate",
            "type": "string"
          },
          "format": {
            "default": "markdown",
            "enum": [
              "markdown",
              "json"
            ],
            "title": "Format",
            "type": "string"
          },
          "min_matched_traces": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Matched Traces"
          }
        },
        "required": [
          "baseline",
          "candidate"
        ],
        "title": "Body_report_api_report_post",
        "type": "object"
      },
      "CompareResponse": {
        "properties": {
          "comparison": {
            "$ref": "#/components/schemas/Comparison"
          }
        },
        "required": [
          "comparison"
        ],
        "title": "CompareResponse",
        "type": "object"
      },
      "Comparison": {
        "properties": {
          "baseline_digest": {
            "title": "Baseline Digest",
            "type": "string"
          },
          "baseline_only_traces": {
            "items": {
              "type": "string"
            },
            "title": "Baseline Only Traces",
            "type": "array"
          },
          "baseline_pass_rate": {
            "title": "Baseline Pass Rate",
            "type": "number"
          },
          "baseline_run_id": {
            "title": "Baseline Run Id",
            "type": "string"
          },
          "candidate_digest": {
            "title": "Candidate Digest",
            "type": "string"
          },
          "candidate_only_traces": {
            "items": {
              "type": "string"
            },
            "title": "Candidate Only Traces",
            "type": "array"
          },
          "candidate_pass_rate": {
            "title": "Candidate Pass Rate",
            "type": "number"
          },
          "candidate_run_id": {
            "title": "Candidate Run Id",
            "type": "string"
          },
          "criteria": {
            "items": {
              "$ref": "#/components/schemas/CriterionDelta"
            },
            "title": "Criteria",
            "type": "array"
          },
          "hard_gate_regressions": {
            "items": {
              "type": "string"
            },
            "title": "Hard Gate Regressions",
            "type": "array"
          },
          "matched_traces": {
            "title": "Matched Traces",
            "type": "integer"
          },
          "net_change": {
            "title": "Net Change",
            "type": "number"
          },
          "newly_failing_traces": {
            "items": {
              "type": "string"
            },
            "title": "Newly Failing Traces",
            "type": "array"
          },
          "newly_passing_traces": {
            "items": {
              "type": "string"
            },
            "title": "Newly Passing Traces",
            "type": "array"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/VerdictReason"
            },
            "title": "Reasons",
            "type": "array"
          },
          "suite": {
            "title": "Suite",
            "type": "string"
          },
          "trace_details": {
            "items": {
              "$ref": "#/components/schemas/TraceComparison"
            },
            "title": "Trace Details",
            "type": "array"
          },
          "verdict": {
            "title": "Verdict",
            "type": "string"
          }
        },
        "required": [
          "suite",
          "baseline_run_id",
          "candidate_run_id",
          "baseline_digest",
          "candidate_digest",
          "matched_traces",
          "baseline_only_traces",
          "candidate_only_traces",
          "baseline_pass_rate",
          "candidate_pass_rate",
          "net_change",
          "criteria",
          "newly_passing_traces",
          "newly_failing_traces",
          "hard_gate_regressions",
          "trace_details",
          "verdict",
          "reasons"
        ],
        "title": "Comparison",
        "type": "object"
      },
      "CriterionCell": {
        "description": "One criterion's baseline-vs-candidate outcome for a single trace (S-3).\n\nThe state, verdict, and rationale are computed here in the domain layer; the\nfrontend renders them and never re-derives an outcome.",
        "properties": {
          "baseline_result": {
            "anyOf": [
              {
                "enum": [
                  "pass",
                  "fail"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Result"
          },
          "candidate_result": {
            "anyOf": [
              {
                "enum": [
                  "pass",
                  "fail"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidate Result"
          },
          "changed": {
            "title": "Changed",
            "type": "boolean"
          },
          "criterion_id": {
            "title": "Criterion Id",
            "type": "string"
          },
          "hard_gate": {
            "title": "Hard Gate",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "provenance": {
            "enum": [
              "both",
              "baseline_only",
              "candidate_only",
              "neither"
            ],
            "title": "Provenance",
            "type": "string"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "state": {
            "enum": [
              "improved",
              "regressed",
              "unchanged",
              "missing",
              "insufficient",
              "conflicting",
              "not_evaluated"
            ],
            "title": "State",
            "type": "string"
          },
          "verdict": {
            "title": "Verdict",
            "type": "string"
          }
        },
        "required": [
          "criterion_id",
          "name",
          "hard_gate",
          "baseline_result",
          "candidate_result",
          "changed",
          "state",
          "verdict",
          "rationale",
          "provenance"
        ],
        "title": "CriterionCell",
        "type": "object"
      },
      "CriterionDelta": {
        "properties": {
          "baseline_pass_rate": {
            "title": "Baseline Pass Rate",
            "type": "number"
          },
          "candidate_pass_rate": {
            "title": "Candidate Pass Rate",
            "type": "number"
          },
          "covered_traces": {
            "title": "Covered Traces",
            "type": "integer"
          },
          "criterion_id": {
            "title": "Criterion Id",
            "type": "string"
          },
          "delta": {
            "title": "Delta",
            "type": "number"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "hard_gate": {
            "title": "Hard Gate",
            "type": "boolean"
          },
          "newly_failing": {
            "items": {
              "type": "string"
            },
            "title": "Newly Failing",
            "type": "array"
          },
          "newly_passing": {
            "items": {
              "type": "string"
            },
            "title": "Newly Passing",
            "type": "array"
          }
        },
        "required": [
          "criterion_id",
          "description",
          "hard_gate",
          "baseline_pass_rate",
          "candidate_pass_rate",
          "delta",
          "newly_passing",
          "newly_failing",
          "covered_traces"
        ],
        "title": "CriterionDelta",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "api_version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ParseIssue": {
        "description": "One named problem with an uploaded run file.",
        "properties": {
          "location": {
            "title": "Location",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "location",
          "message"
        ],
        "title": "ParseIssue",
        "type": "object"
      },
      "SizeLimitResponse": {
        "description": "The 413 body \u2014 one documented shape for either size boundary: the\nwhole-request cap (the middleware, before parsing) and the per-file cap\n(``_read_capped``, at read-back) both emit ``{\"detail\": str}``.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "SizeLimitResponse",
        "type": "object"
      },
      "TraceComparison": {
        "description": "One changed trace's full per-criterion detail and evidence fields (S-3).",
        "properties": {
          "baseline_label": {
            "title": "Baseline Label",
            "type": "string"
          },
          "baseline_notes": {
            "title": "Baseline Notes",
            "type": "string"
          },
          "candidate_label": {
            "title": "Candidate Label",
            "type": "string"
          },
          "candidate_notes": {
            "title": "Candidate Notes",
            "type": "string"
          },
          "changed": {
            "title": "Changed",
            "type": "boolean"
          },
          "criteria": {
            "items": {
              "$ref": "#/components/schemas/CriterionCell"
            },
            "title": "Criteria",
            "type": "array"
          },
          "direction": {
            "enum": [
              "improved",
              "regressed",
              "mixed"
            ],
            "title": "Direction",
            "type": "string"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "trace_id",
          "direction",
          "changed",
          "baseline_label",
          "baseline_notes",
          "candidate_label",
          "candidate_notes",
          "criteria"
        ],
        "title": "TraceComparison",
        "type": "object"
      },
      "ValidationErrorResponse": {
        "description": "The single 422 envelope: every validation failure \u2014 malformed upload,\nout-of-range config, or a native transport type error \u2014 is reported as\n``{\"detail\": [ValidationProblem, ...]}`` so one committed schema matches\nthe wire for all of them (P-4).",
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationProblem"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ValidationErrorResponse",
        "type": "object"
      },
      "ValidationProblem": {
        "properties": {
          "issues": {
            "items": {
              "$ref": "#/components/schemas/ParseIssue"
            },
            "title": "Issues",
            "type": "array"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "source",
          "issues"
        ],
        "title": "ValidationProblem",
        "type": "object"
      },
      "VerdictReason": {
        "properties": {
          "criterion_id": {
            "default": "",
            "title": "Criterion Id",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "trace_ids": {
            "items": {
              "type": "string"
            },
            "title": "Trace Ids",
            "type": "array"
          }
        },
        "required": [
          "kind",
          "detail"
        ],
        "title": "VerdictReason",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Compare two eval runs and receive an evidence-backed release verdict. Uploads are processed in memory and never stored.",
    "title": "pm-evals Web API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/compare": {
      "post": {
        "operationId": "compare_api_compare_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_compare_api_compare_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompareResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SizeLimitResponse"
                }
              }
            },
            "description": "The request exceeds a size limit \u2014 the whole-request cap (enforced before parsing) or an individual file's cap."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "A validation failure: one or more named per-source problems."
          }
        },
        "summary": "Compare"
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SizeLimitResponse"
                }
              }
            },
            "description": "The request exceeds a size limit \u2014 the whole-request cap (enforced before parsing) or an individual file's cap."
          }
        },
        "summary": "Health"
      }
    },
    "/api/report": {
      "post": {
        "operationId": "report_api_report_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_report_api_report_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "The comparison report as a downloadable attachment (text/markdown or application/json, server-generated filename)."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SizeLimitResponse"
                }
              }
            },
            "description": "The request exceeds a size limit \u2014 the whole-request cap (enforced before parsing) or an individual file's cap."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "A validation failure: one or more named per-source problems."
          }
        },
        "summary": "Report"
      }
    }
  }
}
