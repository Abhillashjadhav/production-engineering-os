{
  "$defs": {
    "acceptance_criterion_id": {
      "pattern": "^AC-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string"
    },
    "acceptance_reference_list": {
      "items": {
        "$ref": "#/$defs/acceptance_criterion_id"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "actor_id": {
      "pattern": "^(?:ACTOR|OWNER)-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string"
    },
    "approval_id": {
      "pattern": "^APR-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string"
    },
    "approval_reference_list": {
      "items": {
        "$ref": "#/$defs/approval_id"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "authority_policy_id": {
      "pattern": "^AUTH-POLICY-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string"
    },
    "bundle_id": {
      "pattern": "^BUNDLE-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string"
    },
    "date_time": {
      "description": "UTC RFC 3339 instant. Calendar validity is rechecked by the semantic validator.",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$",
      "type": "string"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "duration": {
      "description": "ISO-8601 duration containing at least one numeric component.",
      "pattern": "^P(?=.*[0-9])(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+W)?(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+(?:\\.[0-9]+)?S)?)?$",
      "type": "string"
    },
    "https_uri": {
      "description": "Absolute HTTPS schema identifier.",
      "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?::[0-9]{1,5})?(?:/[^\\s]*)?$",
      "type": "string"
    },
    "metric_policy_id": {
      "pattern": "^POLICY-METRIC-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string"
    },
    "non_empty_string": {
      "minLength": 1,
      "type": "string"
    },
    "requirement_id": {
      "pattern": "^(?:FR|NFR)-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string"
    },
    "requirement_reference_list": {
      "items": {
        "$ref": "#/$defs/requirement_id"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "source_id": {
      "pattern": "^PMOS-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string"
    },
    "stable_id": {
      "description": "Globally namespaced stable traceability identifier. Each registry applies a narrower type-specific prefix.",
      "pattern": "^(?:AC|A11Y|APR|ASM|AUTH-POLICY|BUNDLE|CONSTRAINT|DATA|EDGE|EXT|FR|GUARD|INT|MEMBER|METRIC|NFR|OBS|OWNER|PMOS|POLICY|PRIV|QA|QUESTION|REL|RISK|ROLLBACK|SEC|UX-FLOW)-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "type": "string"
    },
    "string_list": {
      "items": {
        "$ref": "#/$defs/non_empty_string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "subject_reference_list": {
      "items": {
        "$ref": "#/$defs/stable_id"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "time_zone": {
      "description": "UTC or an IANA-style region/location identifier.",
      "pattern": "^(?:UTC|[A-Za-z_]+/[A-Za-z0-9_+\\-]+)$",
      "type": "string"
    },
    "window": {
      "additionalProperties": false,
      "description": "Product-owned window rule. It defines how a later controller assigns due times; the schema supplies no default.",
      "properties": {
        "anchor_event": {
          "$ref": "#/$defs/non_empty_string"
        },
        "duration": {
          "$ref": "#/$defs/duration"
        },
        "time_zone": {
          "$ref": "#/$defs/time_zone"
        }
      },
      "required": [
        "anchor_event",
        "duration",
        "time_zone"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/Abhillashjadhav/production-engineering-os/schemas/pmos_contract_bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical PM Agent OS product-truth bundle consumed by Production Engineering OS. PMOS owns every product value; PEOS validates and executes without inventing missing truth. Existing V1-V3 contracts remain separate inputs until the compiler and migrations in issue #76 map them here.",
  "properties": {
    "acceptance_criteria": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "criterion": {
            "$ref": "#/$defs/non_empty_string"
          },
          "requirement_refs": {
            "$ref": "#/$defs/requirement_reference_list"
          },
          "verification_method": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "required": [
          "criterion",
          "requirement_refs",
          "verification_method"
        ],
        "type": "object"
      },
      "description": "Registry keyed by stable acceptance-criterion ID.",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/acceptance_criterion_id"
      },
      "type": "object"
    },
    "approvals": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "actor_id": {
            "$ref": "#/$defs/actor_id"
          },
          "approval_version": {
            "$ref": "#/$defs/semver"
          },
          "approved_at": {
            "$ref": "#/$defs/date_time"
          },
          "authority_policy_ref": {
            "$ref": "#/$defs/authority_policy_id"
          },
          "authority_policy_version": {
            "$ref": "#/$defs/semver"
          },
          "decision": {
            "enum": [
              "APPROVED",
              "REJECTED"
            ],
            "type": "string"
          },
          "expires_at": {
            "$ref": "#/$defs/date_time"
          },
          "revocation_reason": {
            "$ref": "#/$defs/non_empty_string"
          },
          "revoked_at": {
            "$ref": "#/$defs/date_time"
          },
          "role": {
            "$ref": "#/$defs/non_empty_string"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "REVOKED",
              "SUPERSEDED"
            ],
            "type": "string"
          },
          "subject": {
            "additionalProperties": false,
            "description": "Exact immutable approval subject. Bundle approvals bind a projection that excludes approvals to avoid a self-referential digest.",
            "properties": {
              "digest": {
                "$ref": "#/$defs/digest"
              },
              "digest_scope": {
                "enum": [
                  "CANONICAL_BUNDLE_EXCLUDING_APPROVALS",
                  "NAMED_POLICY"
                ],
                "type": "string"
              },
              "id": {
                "$ref": "#/$defs/stable_id"
              },
              "version": {
                "$ref": "#/$defs/semver"
              }
            },
            "required": [
              "digest",
              "digest_scope",
              "id",
              "version"
            ],
            "type": "object"
          },
          "supersedes_approval_refs": {
            "items": {
              "$ref": "#/$defs/approval_id"
            },
            "type": "array",
            "uniqueItems": true
          },
          "valid_from": {
            "$ref": "#/$defs/date_time"
          }
        },
        "required": [
          "actor_id",
          "approval_version",
          "approved_at",
          "authority_policy_ref",
          "authority_policy_version",
          "decision",
          "expires_at",
          "role",
          "status",
          "subject",
          "supersedes_approval_refs",
          "valid_from"
        ],
        "type": "object"
      },
      "description": "Registry keyed by stable approval ID. Approval authority and freshness are semantic policy, not inferred by this schema.",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/approval_id"
      },
      "type": "object"
    },
    "assumptions": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "statement": {
            "$ref": "#/$defs/non_empty_string"
          },
          "validation_plan": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "required": [
          "statement",
          "validation_plan"
        ],
        "type": "object"
      },
      "description": "Registry keyed by stable assumption ID. An empty object explicitly means PMOS approved no assumptions.",
      "propertyNames": {
        "pattern": "^ASM-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
        "type": "string"
      },
      "type": "object"
    },
    "bundle_id": {
      "$ref": "#/$defs/bundle_id"
    },
    "bundle_version": {
      "$ref": "#/$defs/semver"
    },
    "contract_status": {
      "enum": [
        "DRAFT",
        "APPROVED",
        "SUPERSEDED",
        "REJECTED"
      ],
      "type": "string"
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "requirements": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "classification": {
                "enum": [
                  "PUBLIC",
                  "INTERNAL",
                  "CONFIDENTIAL",
                  "RESTRICTED"
                ],
                "type": "string"
              },
              "purpose": {
                "$ref": "#/$defs/non_empty_string"
              },
              "requirement": {
                "$ref": "#/$defs/non_empty_string"
              },
              "retention": {
                "$ref": "#/$defs/non_empty_string"
              }
            },
            "required": [
              "classification",
              "purpose",
              "requirement",
              "retention"
            ],
            "type": "object"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^DATA-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "requirements"
      ],
      "type": "object"
    },
    "extensions": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "effect": {
            "const": "ADD_CONSTRAINTS_ONLY",
            "description": "Extensions may add constraints but can never weaken or replace core truth."
          },
          "payload": {
            "additionalProperties": false,
            "description": "Bounded conjunctive constraint vocabulary. It can only require, forbid, limit, or further constrain values; override and removal operations are not representable.",
            "properties": {
              "constraints": {
                "additionalProperties": {
                  "additionalProperties": false,
                  "properties": {
                    "constraint_value": {
                      "$ref": "#/$defs/non_empty_string"
                    },
                    "operator": {
                      "enum": [
                        "FORBID_VALUE",
                        "LIMIT_ALLOWED_VALUES",
                        "MATCH_PATTERN",
                        "REQUIRE_PRESENT",
                        "SET_MAXIMUM",
                        "SET_MINIMUM"
                      ],
                      "type": "string"
                    },
                    "rationale": {
                      "$ref": "#/$defs/non_empty_string"
                    },
                    "target_pointer": {
                      "description": "JSON Pointer into the canonical core.",
                      "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "constraint_value",
                    "operator",
                    "rationale",
                    "target_pointer"
                  ],
                  "type": "object"
                },
                "minProperties": 1,
                "propertyNames": {
                  "pattern": "^EXT-CONSTRAINT-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
                  "type": "string"
                },
                "type": "object"
              }
            },
            "required": [
              "constraints"
            ],
            "type": "object"
          },
          "payload_digest": {
            "$ref": "#/$defs/digest"
          },
          "schema_id": {
            "$ref": "#/$defs/https_uri"
          },
          "schema_version": {
            "$ref": "#/$defs/semver"
          },
          "target_refs": {
            "$ref": "#/$defs/subject_reference_list"
          }
        },
        "required": [
          "effect",
          "payload",
          "payload_digest",
          "schema_id",
          "schema_version",
          "target_refs"
        ],
        "type": "object"
      },
      "description": "Typed repository-specific extension registry. Unknown extension schemas fail during compiler admission in issue #76.",
      "propertyNames": {
        "pattern": "^EXT-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
        "type": "string"
      },
      "type": "object"
    },
    "functional_requirements": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "acceptance_criterion_refs": {
            "$ref": "#/$defs/acceptance_reference_list"
          },
          "priority": {
            "enum": [
              "MUST",
              "SHOULD",
              "COULD"
            ],
            "type": "string"
          },
          "statement": {
            "$ref": "#/$defs/non_empty_string"
          },
          "title": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "required": [
          "acceptance_criterion_refs",
          "priority",
          "statement",
          "title"
        ],
        "type": "object"
      },
      "description": "Registry keyed by stable functional-requirement ID.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^FR-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
        "type": "string"
      },
      "type": "object"
    },
    "guardrails": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "AUTONOMY",
              "COST",
              "DEVELOPER_EXPERIENCE",
              "PRIVACY",
              "QUALITY",
              "RELIABILITY",
              "SECURITY"
            ],
            "type": "string"
          },
          "description": {
            "$ref": "#/$defs/non_empty_string"
          },
          "response": {
            "$ref": "#/$defs/non_empty_string"
          },
          "threshold": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "required": [
          "category",
          "description",
          "response",
          "threshold"
        ],
        "type": "object"
      },
      "description": "Registry keyed by stable guardrail ID.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^GUARD-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
        "type": "string"
      },
      "type": "object"
    },
    "integrations": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "authentication": {
            "$ref": "#/$defs/non_empty_string"
          },
          "direction": {
            "enum": [
              "INBOUND",
              "OUTBOUND",
              "BIDIRECTIONAL"
            ],
            "type": "string"
          },
          "name": {
            "$ref": "#/$defs/non_empty_string"
          },
          "purpose": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "required": [
          "authentication",
          "direction",
          "name",
          "purpose"
        ],
        "type": "object"
      },
      "description": "Registry keyed by stable integration ID. Credentials are never embedded.",
      "propertyNames": {
        "pattern": "^INT-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
        "type": "string"
      },
      "type": "object"
    },
    "metrics": {
      "additionalProperties": false,
      "properties": {
        "leading": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "definition": {
                "$ref": "#/$defs/non_empty_string"
              },
              "direction": {
                "enum": [
                  "DECREASE",
                  "INCREASE",
                  "MAINTAIN"
                ],
                "type": "string"
              },
              "maturity_policy_ref": {
                "$ref": "#/$defs/metric_policy_id"
              },
              "name": {
                "$ref": "#/$defs/non_empty_string"
              }
            },
            "required": [
              "definition",
              "direction",
              "maturity_policy_ref",
              "name"
            ],
            "type": "object"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^METRIC-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
            "type": "string"
          },
          "type": "object"
        },
        "maturity_policies": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "applicable_autonomy_stages": {
                "items": {
                  "enum": [
                    "DRAFT_PR",
                    "STAGING",
                    "CANARY",
                    "PRODUCTION"
                  ],
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "approval_ref": {
                "$ref": "#/$defs/approval_id"
              },
              "name": {
                "$ref": "#/$defs/non_empty_string"
              },
              "owner_ref": {
                "$ref": "#/$defs/actor_id"
              },
              "policy_version": {
                "$ref": "#/$defs/semver"
              }
            },
            "required": [
              "applicable_autonomy_stages",
              "approval_ref",
              "name",
              "owner_ref",
              "policy_version"
            ],
            "type": "object"
          },
          "description": "Named, versioned, owner-approved metric maturity policies.",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/metric_policy_id"
          },
          "type": "object"
        },
        "north_star": {
          "additionalProperties": false,
          "properties": {
            "definition": {
              "$ref": "#/$defs/non_empty_string"
            },
            "delivery_window": {
              "$ref": "#/$defs/window"
            },
            "direction": {
              "enum": [
                "DECREASE",
                "INCREASE",
                "MAINTAIN"
              ],
              "type": "string"
            },
            "evaluation_window": {
              "$ref": "#/$defs/window"
            },
            "maturity_policy_ref": {
              "$ref": "#/$defs/metric_policy_id"
            },
            "metric_id": {
              "pattern": "^METRIC-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
              "type": "string"
            },
            "name": {
              "$ref": "#/$defs/non_empty_string"
            },
            "observation_window": {
              "$ref": "#/$defs/window"
            },
            "reporting_window": {
              "$ref": "#/$defs/window"
            },
            "target": {
              "additionalProperties": false,
              "properties": {
                "approval_ref": {
                  "$ref": "#/$defs/approval_id"
                },
                "operator": {
                  "enum": [
                    "AT_LEAST",
                    "AT_MOST",
                    "EXACT"
                  ],
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "APPROVED",
                    "BASELINE_REQUIRED",
                    "RETIRED"
                  ],
                  "type": "string"
                },
                "unit": {
                  "$ref": "#/$defs/non_empty_string"
                },
                "value": {
                  "type": "number"
                }
              },
              "required": [
                "approval_ref",
                "operator",
                "status",
                "unit",
                "value"
              ],
              "type": "object"
            }
          },
          "required": [
            "definition",
            "delivery_window",
            "direction",
            "evaluation_window",
            "maturity_policy_ref",
            "metric_id",
            "name",
            "observation_window",
            "reporting_window",
            "target"
          ],
          "type": "object"
        }
      },
      "required": [
        "leading",
        "maturity_policies",
        "north_star"
      ],
      "type": "object"
    },
    "non_functional_requirements": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "ACCESSIBILITY",
              "COST",
              "MAINTAINABILITY",
              "PERFORMANCE",
              "PRIVACY",
              "RELIABILITY",
              "SCALABILITY",
              "SECURITY",
              "USABILITY"
            ],
            "type": "string"
          },
          "evidence_expectation": {
            "$ref": "#/$defs/non_empty_string"
          },
          "requirement": {
            "$ref": "#/$defs/non_empty_string"
          },
          "target": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "required": [
          "category",
          "evidence_expectation",
          "requirement",
          "target"
        ],
        "type": "object"
      },
      "description": "Registry keyed by stable non-functional-requirement ID.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^NFR-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
        "type": "string"
      },
      "type": "object"
    },
    "observability": {
      "additionalProperties": false,
      "properties": {
        "requirements": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "alert_condition": {
                "$ref": "#/$defs/non_empty_string"
              },
              "requirement": {
                "$ref": "#/$defs/non_empty_string"
              },
              "signal": {
                "$ref": "#/$defs/non_empty_string"
              }
            },
            "required": [
              "alert_condition",
              "requirement",
              "signal"
            ],
            "type": "object"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^OBS-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "requirements"
      ],
      "type": "object"
    },
    "open_questions": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "blocking": {
            "type": "boolean"
          },
          "owner_ref": {
            "$ref": "#/$defs/actor_id"
          },
          "question": {
            "$ref": "#/$defs/non_empty_string"
          },
          "resolution": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "required": [
          "blocking",
          "owner_ref",
          "question"
        ],
        "type": "object"
      },
      "description": "Registry keyed by stable question ID. Blocking/resolution consistency is semantic policy in issue #63.",
      "propertyNames": {
        "pattern": "^QUESTION-[A-Z0-9]+(?:-[A-Z0-9]+)*$",
        "type": "string"
      },
      "type": "object"
    },
    "privacy": {
      "additionalProperties": false,
