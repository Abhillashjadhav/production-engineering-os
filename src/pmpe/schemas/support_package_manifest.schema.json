{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pmpe.local/schemas/support-package-manifest-1.0.0.json",
  "additionalProperties": false,
  "properties": {
    "approval": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "type": "string"
        },
        "receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "status": {
          "const": "VERIFIED"
        }
      },
      "required": [
        "authority",
        "receipt_digest",
        "status"
      ],
      "type": "object"
    },
    "capabilities": {
      "type": "object"
    },
    "claims": {
      "additionalProperties": false,
      "properties": {
        "container_reproducibility": {
          "const": "NOT_CLAIMED"
        },
        "injection_resistance": {
          "const": "NOT_PROVEN"
        },
        "live_model_quality": {
          "const": "NOT_PROVEN"
        },
        "production_deployment": {
          "const": "OUT_OF_SCOPE"
        },
        "recorded_mode_only": {
          "const": true
        },
        "vendor_connector": {
          "const": "NOT_PROVEN"
        }
      },
      "required": [
        "recorded_mode_only",
        "live_model_quality",
        "injection_resistance",
        "vendor_connector",
        "production_deployment",
        "container_reproducibility"
      ],
      "type": "object"
    },
    "contract_digest": {
      "$ref": "#/$defs/digest"
    },
    "evidence_schema_version": {
      "const": "2.0.0-package"
    },
    "files": {
      "additionalProperties": {
        "$ref": "#/$defs/digest"
      },
      "minProperties": 1,
      "type": "object"
    },
    "forbidden_capability_proofs": {
      "type": "object"
    },
    "lockfile_digest": {
      "$ref": "#/$defs/digest"
    },
    "manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "package_subject_digest": {
      "$ref": "#/$defs/digest"
    },
    "ports": {
      "additionalProperties": false,
      "properties": {
        "model_gateway": {
          "additionalProperties": false,
          "properties": {
            "corpus_digest": {
              "$ref": "#/$defs/digest"
            },
            "mode": {
              "const": "recorded"
            }
          },
          "required": [
            "mode",
            "corpus_digest"
          ],
          "type": "object"
        },
        "ticket_connector": {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "fixture"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        "ticket_repository": {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "memory"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        }
      },
      "required": [
        "model_gateway",
        "ticket_repository",
        "ticket_connector"
      ],
      "type": "object"
    },
    "sbom_digest": {
      "$ref": "#/$defs/digest"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "source_digest": {
      "$ref": "#/$defs/digest"
    },
    "state": {
      "const": "PACKAGE_READY"
    },
    "state_vocabulary": {
      "additionalProperties": false,
      "properties": {
        "candidate_terminal": {
          "const": "RELEASE_READY"
        },
        "package_terminal": {
          "const": "PACKAGE_READY"
        }
      },
      "required": [
        "candidate_terminal",
        "package_terminal"
      ],
      "type": "object"
    },
    "verification": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "evidence_schema_version",
    "state",
    "state_vocabulary",
    "approval",
    "contract_digest",
    "capabilities",
    "forbidden_capability_proofs",
    "ports",
    "files",
    "source_digest",
    "lockfile_digest",
    "sbom_digest",
    "verification",
    "package_subject_digest",
    "claims",
    "manifest_digest"
  ],
  "title": "PMPE customer-support portable package manifest",
  "type": "object",
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  }
}
